# Node.js 22.13+。公开部署请设置可信反向代理和 HTTPS。
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3001
# HTTPS 部署必须设置为 true；开发环境 false。
COOKIE_SECURE=false
# 默认不信任代理。仅当应用位于可信单层反向代理后时设为 1。
TRUST_PROXY=0
# 是否在 API 进程中启动探测器。单实例部署即可。
RUN_WORKER=true
# 可选：Casdoor Authorization Code 登录。四项必须同时设置，回调地址须与 Casdoor 控制台完全一致。
# CASDOOR_ORIGIN=https://auth.example.com
# CASDOOR_CLIENT_ID=replace-with-client-id
# CASDOOR_CLIENT_SECRET=replace-with-client-secret
# CASDOOR_REDIRECT_URI=https://example.com/api/auth/casdoor/callback
